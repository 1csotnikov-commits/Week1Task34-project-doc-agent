# Скопируйте в .env и заполните только те ключи, которые нужны.
# Файл .env запрещено коммитить: он перечислен в .gitignore.
# API-ключи читаются только из переменных окружения.

DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=

# Необязательно: путь к альтернативному providers.yaml.
# DOCAGENT_PROVIDERS=C:/DocumentWork/project-doc-agent/config/providers.yaml

# Необязательно: включить сохранение сырых ответов LLM для отладки.
# DOCAGENT_SAVE_LLM_RAW=0
